  <relations>
    <relation id="rel_titular_processo" name="Processos Minerários do Titular" referencingLayer="lyr_processo" referencedLayer="lyr_titular" strength="Association">
      <fieldRef referencingField="titular_id" referencedField="id"/>
    </relation>
    <relation id="rel_processo_evento" name="Histórico de Eventos Regulatórios" referencingLayer="lyr_evento" referencedLayer="lyr_processo" strength="Composition">
      <fieldRef referencingField="processo_id" referencedField="id"/>
