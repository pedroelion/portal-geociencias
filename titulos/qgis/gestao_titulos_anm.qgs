    <maplayer type="vector" geometry="Polygon" hasScaleBasedVisibilityFlag="0" autoRefreshEnabled="0" readOnly="0">
      <id>lyr_processo</id>
      <datasource>dbname='gestao_titulos_minerarios' host='localhost' port='5432' user='pedro' password='123' sslmode=prefer key='id' srid=4674 type=MultiPolygon table="public"."processo" (geom)</datasource>
      <keywordList/>
      <layername>Poligonais de Processos (Cadastro Base)</layername>
      <srs/>
      <spatialrefsys>
        <authid>EPSG:4674</authid>
        <srid>4674</srid>
        <description>SIRGAS 2000</description>
      </spatialrefsys>
      <provider encoding="UTF-8">postgres</provider>
      <editorlayout>tablayout</editorlayout>
      <attributeEditorForm>
        <attributeEditorContainer name="1. Dados Cadastrais ANM" columnCount="2" groupBox="0" visibilityExpression="">
          <attributeEditorField name="numero_processo" index="0"/>
          <attributeEditorField name="ano_processo" index="0"/>
          <attributeEditorField name="titular_id" index="0"/>
          <attributeEditorField name="fase" index="0"/>
          <attributeEditorField name="substancia_mineral" index="0"/>
          <attributeEditorField name="uso_substancia" index="0"/>
          <attributeEditorField name="area_ha" index="0"/>
          <attributeEditorField name="municipio" index="0"/>
          <attributeEditorField name="uf" index="0"/>
        </attributeEditorContainer>
        <attributeEditorContainer name="2. Marcos Regulatórios" columnCount="2" groupBox="0" visibilityExpression="">
          <attributeEditorField name="data_requerimento" index="0"/>
          <attributeEditorField name="data_publicacao_alvara" index="0"/>
          <attributeEditorField name="prazo_alvara_anos" index="0"/>
          <attributeEditorField name="data_vencimento_alvara" index="0"/>
          <attributeEditorField name="data_portaria_lavra" index="0"/>
          <attributeEditorField name="status_processo" index="0"/>
        </attributeEditorContainer>
        <attributeEditorContainer name="3. Histórico de Eventos" columnCount="1" groupBox="0" visibilityExpression="">
          <attributeEditorRelation name="rel_processo_evento" relation="rel_processo_evento" showLabel="1"/>
        </attributeEditorContainer>
        <attributeEditorContainer name="4. Prazos e Obrigações Legais" columnCount="1" groupBox="0" visibilityExpression="">
          <attributeEditorRelation name="rel_processo_obrigacao" relation="rel_processo_obrigacao" showLabel="1"/>
        </attributeEditorContainer>
      </attributeEditorForm>
      <constraints>
        <constraint field="numero_processo" constraints="3" exp="regexp_match(&quot;numero_processo&quot;, '^\\d{3,6}\\.\\d{3}/\\d{4}$')" desc="Formato de processo ANM inválido! Utilize o padrão: 800.123/2021"/>
        <constraint field="area_ha" constraints="3" exp="&quot;area_ha&quot; &gt; 0" desc="A área do processo deve ser superior a zero hectares!"/>
        <constraint field="ano_processo" constraints="3" exp="&quot;ano_processo&quot; &gt;= 1934 AND &quot;ano_processo&quot; &lt;= 2100" desc="Ano de processo inválido."/>
      </constraints>
    </maplayer>
