  </layer-tree-group>
  <projectlayers>
    <maplayer type="vector" geometry="Polygon" hasScaleBasedVisibilityFlag="0" autoRefreshEnabled="0" readOnly="0">
      <id>lyr_situacao_espacial</id>
      <datasource>dbname='gestao_titulos_minerarios' host='localhost' port='5432' user='pedro' password='123' sslmode=prefer key='processo_id' srid=4674 type=MultiPolygon table="public"."vw_processos_situacao_espacial" (geom)</datasource>
      <keywordList/>
      <layername>Situação Espacial e Pior Alerta (Geral)</layername>
      <srs/>
      <spatialrefsys>
        <authid>EPSG:4674</authid>
        <srid>4674</srid>
        <description>SIRGAS 2000</description>
      </spatialrefsys>
      <provider encoding="UTF-8">postgres</provider>
      <renderer-v2 type="RuleRenderer" symbollevels="0">
        <rules key="root">
          <rule key="rule_venc" label="Obrigação Vencida (Crítico)" filter="&quot;pior_nivel_alerta&quot; = 'Vencido'" symbol="sym_venc"/>
          <rule key="rule_crit" label="Próximo ao Vencimento (≤ 30 dias)" filter="&quot;pior_nivel_alerta&quot; = 'Alerta Crítico / Próximo ao Vencimento'" symbol="sym_crit"/>
          <rule key="rule_ok" label="No Prazo (&gt; 30 dias)" filter="&quot;pior_nivel_alerta&quot; = 'No Prazo'" symbol="sym_ok"/>
          <rule key="rule_cump" label="Regular / Cumprido" filter="&quot;pior_nivel_alerta&quot; = 'Cumprido / Regular'" symbol="sym_cump"/>
        </rules>
        <symbols>
          <symbol name="sym_venc" type="fill" alpha="0.7">
            <layer class="SimpleFill" locked="0" pass="0">
              <prop k="color" v="217,4,41,180"/>
              <prop k="outline_color" v="114,0,38,255"/>
              <prop k="outline_width" v="0.6"/>
            </layer>
          </symbol>
          <symbol name="sym_crit" type="fill" alpha="0.7">
            <layer class="SimpleFill" locked="0" pass="0">
              <prop k="color" v="247,127,0,180"/>
              <prop k="outline_color" v="167,75,0,255"/>
              <prop k="outline_width" v="0.6"/>
            </layer>
          </symbol>
          <symbol name="sym_ok" type="fill" alpha="0.6">
            <layer class="SimpleFill" locked="0" pass="0">
              <prop k="color" v="6,214,160,150"/>
              <prop k="outline_color" v="2,107,80,255"/>
              <prop k="outline_width" v="0.4"/>
            </layer>
          </symbol>
          <symbol name="sym_cump" type="fill" alpha="0.5">
            <layer class="SimpleFill" locked="0" pass="0">
              <prop k="color" v="17,138,178,130"/>
              <prop k="outline_color" v="7,59,76,255"/>
              <prop k="outline_width" v="0.4"/>
            </layer>
          </symbol>
        </symbols>
      </renderer-v2>
      <labeling type="simple">
        <settings calloutType="simple">
          <text-style fontFamily="Segoe UI" fontSize="9" fontWeight="bold" textColor="0,0,0,255" fieldName="&quot;numero_processo&quot; || '&#10;' || &quot;substancia_mineral&quot;"/>
          <text-buffer bufferDraw="1" bufferSize="1.0" bufferColor="255,255,255,230"/>
        </settings>
      </labeling>
    </maplayer>
