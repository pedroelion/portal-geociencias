<?xml version="1.0" encoding="utf-8"?>
<qgis projectname="Sistema Corporativo de Gestão de Títulos Minerários - ANM" version="3.40.15">
  <title>Sistema Corporativo de Gestão de Títulos Minerários - ANM</title>
  <homePath path=""/>
  <autotransaction active="0"/>
  <evaluateDefaultValues active="0"/>
  <trust active="0"/>
  <projectCrs>
    <spatialrefsys>
      <wkt>GEOGCRS["SIRGAS 2000",DATUM["Sistema de Referencia Geocentrico para las Americas 2000",ELLIPSOID["GRS 1980",6378137,298.257222101]],PRIMEM["Greenwich",0],CS[ellipsoidal,2],AXIS["geodetic latitude (Lat)",north],AXIS["geodetic longitude (Lon)",east],ID["EPSG",4674]]</wkt>
      <proj4>+proj=longlat +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +no_defs</proj4>
      <srsid>3224</srsid>
      <srid>4674</srid>
      <authid>EPSG:4674</authid>
      <description>SIRGAS 2000</description>
      <projectionacronym>longlat</projectionacronym>
      <ellipsoidacronym>GRS80</ellipsoidacronym>
      <geographicflag>true</geographicflag>
    </spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <customproperties/>
    <layer-tree-group name="Painel de Situação Espacial" expanded="1" checked="Qt::Checked">
      <layer-tree-layer id="lyr_situacao_espacial" name="Situação Espacial e Pior Alerta (Geral)" source="dbname='gestao_titulos_minerarios' host='localhost' port='5432' user='pedro' password='123' sslmode=prefer key='processo_id' srid=4674 type=MultiPolygon table=&quot;public&quot;.&quot;vw_processos_situacao_espacial&quot; (geom)" providerKey="postgres" checked="Qt::Checked"/>
      <layer-tree-layer id="lyr_relatorio_pesquisa" name="Painel RFP - Relatório de Pesquisa" source="dbname='gestao_titulos_minerarios' host='localhost' port='5432' user='pedro' password='123' sslmode=prefer key='obrigacao_id' srid=4674 type=MultiPolygon table=&quot;public&quot;.&quot;vw_processos_relatorio_pesquisa&quot; (geom)" providerKey="postgres" checked="Qt::Unchecked"/>
      <layer-tree-layer id="lyr_tah" name="Painel TAH - Taxa Anual por Hectare" source="dbname='gestao_titulos_minerarios' host='localhost' port='5432' user='pedro' password='123' sslmode=prefer key='obrigacao_id' srid=4674 type=MultiPolygon table=&quot;public&quot;.&quot;vw_processos_taxa_anual_hectare&quot; (geom)" providerKey="postgres" checked="Qt::Unchecked"/>
      <layer-tree-layer id="lyr_guia_utilizacao" name="Painel GU - Guia de Utilização" source="dbname='gestao_titulos_minerarios' host='localhost' port='5432' user='pedro' password='123' sslmode=prefer key='obrigacao_id' srid=4674 type=MultiPolygon table=&quot;public&quot;.&quot;vw_processos_guia_utilizacao&quot; (geom)" providerKey="postgres" checked="Qt::Unchecked"/>
